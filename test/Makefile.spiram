# Pruebas cocotb de MappedSPIRAM.
#   make -f Makefile.spiram                                   # prueba src/MappedSPIRAM.v
#   make -f Makefile.spiram DUT=$(PWD)/MappedSPIRAM_fixed.v   # prueba la versión corregida
SIM ?= icarus
TOPLEVEL_LANG ?= verilog
SRC_DIR ?= $(abspath $(CURDIR)/../src)

DUT ?= $(SRC_DIR)/MappedSPIRAM.v
SIM_BUILD = sim_build/spiram_$(basename $(notdir $(DUT)))
VERILOG_SOURCES = $(DUT)
TOPLEVEL = MappedSPIRAM
COCOTB_TEST_MODULES = test_mapped_spiram

include $(shell cocotb-config --makefiles)/Makefile.sim
