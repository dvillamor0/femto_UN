# Reloj y Reset internos de la Colorlight i9 v7.2
LOCATE COMP "clk" SITE "P3";
IOBUF PORT "clk" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk" 25 MHZ;

LOCATE COMP "rst_n" SITE "K18";
IOBUF PORT "rst_n" PULLMODE=UP IO_TYPE=LVCMOS33;

# Bus QSPI / SPI Multi-drop (Conector P3 - fila superior PMOD_P3A)
LOCATE COMP "spi_io[0]" SITE "D20";
LOCATE COMP "spi_io[1]" SITE "B19";
LOCATE COMP "spi_io[2]" SITE "A19";
LOCATE COMP "spi_io[3]" SITE "A18";
IOBUF PORT "spi_io[0]" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "spi_io[1]" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "spi_io[2]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "spi_io[3]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=8 SLEWRATE=FAST;

# Control SPI y UART (Conector P3)
LOCATE COMP "spi_sck"        SITE "C4";
LOCATE COMP "spi_cs_flash_n" SITE "C3";
LOCATE COMP "spi_cs_ram_n"   SITE "A3";
LOCATE COMP "led"            SITE "B1";
LOCATE COMP "uart_tx"        SITE "D2";
LOCATE COMP "uart_rx"        SITE "E2";

IOBUF PORT "spi_sck"        IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "spi_cs_flash_n" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "spi_cs_ram_n"   IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "led"            IO_TYPE=LVCMOS33;
IOBUF PORT "uart_tx"        IO_TYPE=LVCMOS33;
IOBUF PORT "uart_rx"        PULLMODE=UP IO_TYPE=LVCMOS33;
