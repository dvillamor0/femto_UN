# Reloj y Reset internos de la Colorlight i9 v7.2
LOCATE COMP "clk" SITE "P3";
IOBUF PORT "clk" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk" 25 MHZ;

LOCATE COMP "rst_n" SITE "K18";
IOBUF PORT "rst_n" PULLMODE=UP IO_TYPE=LVCMOS33;

# Bus QSPI / SPI Multi-drop (Conector P3 - fila superior PMOD_P3A)
LOCATE COMP "uio[0]" SITE "D20";
LOCATE COMP "uio[1]" SITE "B19";
LOCATE COMP "uio[2]" SITE "A19";
LOCATE COMP "uio[3]" SITE "A18";
IOBUF PORT "uio[0]" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "uio[1]" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "uio[2]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "uio[3]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=8 SLEWRATE=FAST;

# Control SPI y UART (Conector P3)
LOCATE COMP "uo_out[0]" SITE "C4";   # spi_sck
LOCATE COMP "uo_out[1]" SITE "C3";   # spi_cs_flash_n
LOCATE COMP "uo_out[2]" SITE "A3";   # spi_cs_ram_n
LOCATE COMP "uo_out[6]" SITE "B1";   # LEDS
LOCATE COMP "uo_out[7]" SITE "D2";   # TXD
LOCATE COMP "ui_in[2]"  SITE "E2";   # RXD

IOBUF PORT "uo_out[0]" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "uo_out[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "uo_out[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "uo_out[6]" IO_TYPE=LVCMOS33;
IOBUF PORT "uo_out[7]" IO_TYPE=LVCMOS33;
IOBUF PORT "ui_in[2]"  PULLMODE=UP IO_TYPE=LVCMOS33;
